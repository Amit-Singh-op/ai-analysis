# Local AI Data Analyst Configuration Example
# Copy this file to .env and adjust variables as needed.

# Application Server
PORT=3000
HOST=127.0.0.1

# PostgreSQL Configuration
# Note: For Docker Compose, the default exposed host port is 5434 to avoid port 5432 collisions.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=telemetry_db

# Read-only user for API queries (enforces least-privilege)
POSTGRES_USER=analyst_user
POSTGRES_PASSWORD=analyst_password

# Admin user for schema creation, table migrations, and seeding
# Tenant-scoped role the app uses for client queries (views only, read-only)
DATABASE_RO_URL=postgresql://analyst_ro:analyst_ro_password@127.0.0.1:5434/telemetry_db
# docker-compose.prod.yml builds DATABASE_RO_URL from this
ANALYST_RO_PASSWORD=change-me

POSTGRES_ADMIN_USER=analyst_admin
POSTGRES_ADMIN_PASSWORD=analyst_secret
DATABASE_ADMIN_URL=postgresql://analyst_admin:analyst_secret@127.0.0.1:5434/telemetry_db

# Local Ollama AI Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model that plans every question (bigger = more accurate, slower on CPU)
PLANNER_MODEL=llama3.2:3b
PLANNER_TIMEOUT_MS=90000

# Set to "off" to disable question logging
QUERY_LOG=on

# Development only: act as this client until JWT sign-in is configured (refused in production)
DEV_CLIENT_ID=1
